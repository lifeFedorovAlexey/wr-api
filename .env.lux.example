# Add to wr-api's environment, or copy to .runtime/dev/lux.env for npm run dev.
LUX_ENABLED=true
LUX_LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Required when /v1/models returns more than one language model.
LUX_LM_STUDIO_MODEL=
# Optional LM Studio server authentication; never expose to the browser.
LUX_LM_STUDIO_API_KEY=
# Set LM Studio's loaded model context to this size or larger.
LUX_CONTEXT_TOKENS=32768
LUX_TIMEOUT_MS=60000
