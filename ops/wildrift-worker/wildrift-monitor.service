[Unit]
Description=Read-only snapshot of Wild Rift production scrape history
After=network-online.target docker.service
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/srv/services/wildrift-worker
ExecStart=/usr/bin/python3 /srv/services/wildrift-worker/observe.py
TimeoutStartSec=35
TimeoutStopSec=8
ExecStopPost=-/usr/bin/python3 /srv/services/wildrift-worker/observe.py --stop-owned
