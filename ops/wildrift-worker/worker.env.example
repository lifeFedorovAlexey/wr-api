# Copy the existing production importer values. This file does not define new keys.
# Save the completed file as secrets/worker.env, owned by root with mode 0600.
DATABASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Copy this too if production uses a non-default region.
S3_REGION=us-east-1
